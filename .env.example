APP_NAME=FIRE-SALE
APP_ENV=development

LEADS_DB_PATH=./data/fire_sale_leads.sqlite3

# Anthropic API key (required by all agents)
ANTHROPIC_API_KEY=

# Email / SMTP settings
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_NAME=Chris

# Lead qualification thresholds
SCORE_DEAD_THRESHOLD=4

# Per-agent API call delays (seconds)
LEAD_GEN_DELAY=2.0
OUTREACH_DELAY=3.0
FOLLOWUP_DELAY=3.0
CLOSER_DELAY=2.0

# Optional
BOOKING_LINK=
SECRET_KEY=  # Future use: webhook signature verification
