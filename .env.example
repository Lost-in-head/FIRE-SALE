APP_NAME=FIRE-SALE
APP_ENV=development

LEADS_DB_PATH=./data/fire_sale_leads.sqlite3

# Language model for scoring, outreach copy, follow-ups, and call briefs.
# Default provider is Anthropic Claude Haiku. No new secret is required:
# a blank LLM_API_KEY falls back to ANTHROPIC_API_KEY for that provider.
# Stages that need a key skip, with a warning, when it is missing.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=
# LLM_BASE_URL is optional. For openai_compatible it may be a full URL or a preset:
#   openai      https://api.openai.com/v1
#   gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   groq        https://api.groq.com/openai/v1
#   together    https://api.together.ai/v1
#   mistral     https://api.mistral.ai/v1
#   xai         https://api.x.ai/v1
#   deepseek    https://api.deepseek.com
#   openrouter  https://openrouter.ai/api/v1
#   ollama      http://localhost:11434/v1
# LLM_BASE_URL=
ANTHROPIC_API_KEY=

# Sender mailbox. For Proton Mail Bridge this is the address inside the Bridge.
# For a Proton SMTP submission token, it is the mailbox the token sends as.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SENDER_NAME=Chris

# SMTP. Do not assume Gmail.
# Proton Mail Bridge on this machine: SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_STARTTLS=true
# Proton SMTP submission token: SMTP_HOST=smtp.protonmail.ch SMTP_PORT=587 SMTP_STARTTLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true

# First runs stay in test mode. Every outbound message is redirected to
# TEST_RECIPIENT. The prospect address is written in the subject and body
# and is not used as the SMTP recipient. Set TEST_MODE=false only when you
# intend to email real prospects. DRY_RUN never sends and never writes leads.
TEST_MODE=true
TEST_RECIPIENT=
DRY_RUN=false

# Optional IMAP reply detection. Leave blank to skip it and use
# backend/status_update.py instead. A bad mailbox does not stop the pipeline.
# Proton Mail Bridge: IMAP_HOST=127.0.0.1 IMAP_PORT=1143 IMAP_SSL=false
# Proton IMAP: IMAP_HOST=127.0.0.1 is wrong; use the Bridge, or IMAP_HOST=imap.protonmail.ch IMAP_PORT=993 IMAP_SSL=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SSL=true
IMAP_FOLDER=INBOX

# Lead qualification thresholds
SCORE_DEAD_THRESHOLD=4

# Per-agent API call delays (seconds)
LEAD_GEN_DELAY=2.0
OUTREACH_DELAY=3.0
FOLLOWUP_DELAY=3.0
CLOSER_DELAY=2.0

# Optional booking link included in outreach and follow-up prompts
BOOKING_LINK=

# Prospector. Blank values use config/prospecting.toml.
# PROSPECTOR_AREAS=brampton,prince_edward_county
# PROSPECTOR_CITIES=Mississauga
# PROSPECTOR_CAMPAIGN=contracting_tree_removal
# PROSPECTOR_CAMPAIGN=web_design
# PROSPECTOR_QUERIES=
# PROSPECTOR_TAGS=
# PROSPECTOR_MAX_LEADS=20
# PROSPECTOR_PROVIDER=osm
# PROSPECTOR_FIND_EMAILS=true
# PROSPECTOR_DELAY=1.1
# PROSPECTOR_CONFIG=config/prospecting.toml
# Identifying contact for the Nominatim User-Agent. Set this before a live run.
# The same User-Agent is sent to the public lead-source feeds. No new secret
# is required for those feeds. Storm-alert email is off in config
# (sources.storm_alerts.notify). Quote pages and the Facebook paste command
# do not use a key.
PROSPECTOR_CONTACT_EMAIL=
# Optional override when the default public Overpass host is refusing connections.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

SECRET_KEY=
